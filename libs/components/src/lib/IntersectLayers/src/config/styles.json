{
    "input": [
      {
        "filter": ["==", ["get", "_type"], "input"],
        "style": {
          "stroke-color": "rgba(255, 99, 71, 1)",
          "stroke-width": 2,
          "circle-radius": 4,
          "circle-fill-color": "rgba(255, 99, 71, 1)",
          "circle-stroke-color": "rgba(255, 255, 255, 1)",
          "circle-stroke-width": 2
        }
      }
    ],
    "output": [
      {
        "filter": ["==", ["get", "_type"], "output"],
        "style": {
          "stroke-color": "rgba(255, 0, 0, 1)",
          "stroke-width": 3,
          "circle-radius": 5,
          "circle-fill-color": "rgba(255, 0, 0, 1)",
          "circle-stroke-color": "rgba(255, 255, 255, 1)",
          "circle-stroke-width": 2
        }
      }
    ],
    "results": [
      {
        "filter": ["==", ["get", "_type"], "results"],
        "style": {
          "fill-color": "rgba(128, 128 , 128, 0.2)",
          "stroke-color": "rgba(0,0,139, 1)",
          "stroke-width": 2,
          "circle-radius": 5,
          "circle-fill-color": "rgba(0,0,139, 1)",
          "circle-stroke-color": "white",
          "circle-stroke-width": 2
        }
      }
    ],
    "selected": [
      {
        "filter": ["all", ["==", ["get", "_type"], "results"], ["==", ["get", "_selected"], true]],
        "style": {
          "fill-color": "rgba(128, 128 , 128, 0.2)",
          "stroke-color": "rgba(0,0,139, 1)",
          "stroke-width": 5,
          "circle-radius": 9,
          "circle-fill-color": "rgba(0,0,139, 1)",
          "circle-stroke-color": "white",
          "circle-stroke-width": 3
        }
      }
    ],  
    "default": {
      "else": true,
      "style": {
        "stroke-color": "cyan",
        "stroke-width": 2,
        "circle-radius": 5,
        "circle-fill-color": "cyan",
        "circle-stroke-color": "white",
        "circle-stroke-width": 2
      }
    }
  }