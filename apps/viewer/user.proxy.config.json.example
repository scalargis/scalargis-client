{
    "/geoserver": {
        "target": "http://localhost:8080/geoserver",
        "changeOrigin": true,
        "rewrite": ""
    },
    "/geoserver": {
        "target": "http://localhost:8080/geoserver",
        "changeOrigin": true,
        "rewriteFrom": "/geoserver",
        "rewriteTo": ""
    },
    "/geoserver": {
        "target": "http://localhost:8080/geoserver",
        "changeOrigin": true,
        "rules": [
            "when": "/geoserver",
            "rewriteTo": ""
        ]
    },
    "/custom": {
        "target": "{{proxyUrl}}/custom",
        "changeOrigin": true,
        "rewrite": ""
    }
}