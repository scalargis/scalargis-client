#Site and entity identification
VITE_APP_TITLE="ScalarGIS"
VITE_APP_DESCRIPTION="ScalarGIS - Web GIS framework"
VITE_APP_ENTITY_NAME="ScalarGIS"
VITE_APP_ENTITY_NAME_ABREV="ScalarGIS"
VITE_APP_ENTITY_URL="https://www.scalargis.com"

BASE="/"

SOURCEMAP='true'

#Application endpoints
VITE_APP_ROOT_PATH=""
VITE_APP_BASE_URL=""
VITE_APP_CLIENT_URL="/"
VITE_APP_API_URL="/api"
VITE_APP_MAP_PROXY="/proxy/?url="
VITE_APP_UPLOAD_URL="/spatial_toolbox/convert2geojson"

#Default config
#VITE_APP_CONFIG_URL="/config.json"

#Default theme
VITE_APP_DEFAULT_THEME="default"

#default locale
#VITE_APP_DEFAULT_LOCALE="pt"

#Cookies
VITE_APP_COOKIE_PREFIX="scalargis_"
VITE_APP_COOKIE_NAME="scalargis_rgpd"
VITE_APP_COOKIE_VALUE="2"
VITE_APP_COOKIE_PATH="/"
VITE_APP_COOKIE_EXPIRES_DAYS="150"
# The cookie banner text is passed to i18n as a translation KEY (with itself as
# the fallback), so a bundle key like defaultRGPDmsg translates in every locale.
# A raw sentence here matches no key and shows untranslated in all languages.
VITE_APP_COOKIE_MESSAGE="defaultRGPDmsg"
VITE_APP_COOKIE_INFO_URL="/static/viewer/rgpd.html"
VITE_APP_COOKIE_AUTH_NAME="scalargis_webgis"
VITE_APP_COOKIE_POPUP_NAME="scalargis_popup"

#Google API keys (Analytics and Maps)
#VITE_APP_GA_TRACKING_ID="UA-xxxxxxxxx-x"
#VITE_APP_GOOGLE_MAPS_API_KEY="xxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"