{
  "name": "viewer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/viewer/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project viewer --web",
  "targets": {
    "build-deploy-server": {
      "metadata": {
        "description": "Build the application for production and copies output files to scalargis-server static folder"
      },
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/viewer",
        "sourcemap": true,
        "outDir": "../../../scalargis-server/scalargis/app/static/viewer",
        "emptyOutDir": true,
        "command": "vite build"
      }
    }
  }
}
