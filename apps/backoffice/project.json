{
  "name": "backoffice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backoffice/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project backoffice --web",
  "targets": {
    "build-deploy-server": {
      "metadata": {
        "description": "Build the application for production and copies output files to scalargis-server static folder"
      },
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backoffice",
        "outDir": "../../../scalargis-server/scalargis/app/static/backoffice",
        "emptyOutDir": true,
        "command": "vite build"
      }
    }
  }
}
