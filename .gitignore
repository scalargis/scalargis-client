# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Environment files
.env
.env.*

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

vite.config.*.timestamp*

# vite user proxy
apps/*/user.proxy.config.json

# sources
apps/viewer/src/app/components/*
apps/backoffice/src/app/components/*
# themes: per-deploy client mounts stay ignored, but the shipped palette
# themes are product code (B2)
apps/viewer/src/app/themes/*
!apps/viewer/src/app/themes/lime
!apps/viewer/src/app/themes/cyan
!apps/viewer/src/app/themes/red
!apps/viewer/src/app/themes/dark-green
!apps/viewer/src/app/themes/brown
vitest.config.*.timestamp*
.nx/polygraph
.nx/self-healing